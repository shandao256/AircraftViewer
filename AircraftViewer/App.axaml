<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="AircraftViewer.App"
             RequestedThemeVariant="Dark">
    <Application.Resources>
        <ResourceDictionary>
            <!-- Palette -->
            <Color x:Key="BackgroundColor">#212529</Color>
            <Color x:Key="TextOnDarkColor">#EDEDED</Color>
            <Color x:Key="AccentColor">#EB5E28</Color>
            <Color x:Key="AccentColor2">#73BA9B</Color>
            <Color x:Key="GrayedTextColor">#CECED4</Color>

            <SolidColorBrush x:Key="BackgroundBrush" Color="{StaticResource BackgroundColor}"/>
            <SolidColorBrush x:Key="TextOnDarkBrush" Color="{StaticResource TextOnDarkColor}"/>
            <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}"/>
            <SolidColorBrush x:Key="AccentBrush2" Color="{StaticResource AccentColor2}"/>
            <SolidColorBrush x:Key="GrayedTextBrush" Color="{StaticResource GrayedTextColor}"/>

            <!-- Background Blur uses BackgroundColor at 80% opacity -->
            <SolidColorBrush x:Key="BackgroundBlurBrush" Color="{StaticResource BackgroundColor}" Opacity="0.8"/>

            <!-- Type scale (sizes only — font family stays Inter for now) -->
            <x:Double x:Key="FontSizeHeader">36</x:Double>
            <x:Double x:Key="FontSizeHeader2">24</x:Double>
            <x:Double x:Key="FontSizeText">16</x:Double>
            <x:Double x:Key="FontSizeCaption">12</x:Double>
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />

        <Style Selector="Window">
            <Setter Property="Background" Value="{StaticResource BackgroundBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextOnDarkBrush}"/>
        </Style>

        <Style Selector="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextOnDarkBrush}"/>
            <Setter Property="FontSize" Value="{StaticResource FontSizeText}"/>
        </Style>
    </Application.Styles>

</Application>